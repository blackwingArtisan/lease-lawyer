# Which reader and translator the browser uses.
#   local   (default) rule-based extractor and keyword classifier, free and offline
#   bedrock posts to /api/read-lease and /api/translate (Cloudflare Pages Functions)
VITE_AI_BACKEND=local

# Server-side only, for the bedrock backend. Set these as Pages secrets, never in the repo.
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
